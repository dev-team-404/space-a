# a-lens backend 환경변수 — 복사해서 .env로 쓰거나 셸에서 export
# (허브 주소는 배포에 따라 바뀔 수 있으므로 코드에 고정하지 않는다)
#
# ⚠️ 이 파일은 자동 로드되지 않는다 — 코드는 os.environ만 읽는다.
#    실행 전에 셸로 밀어넣을 것:  set -a && source .env && set +a
#
# 해석 우선순위: **저장된 설정 파일 > 환경변수 > 코드 기본값** (alens/settings.py).
# 설정 창(로비 ⚙ 설정)에서 저장한 값은 .a-lens/settings.json에 남아 env를 덮어쓴다.

# 원천: auto | hub | dummy | fixtures
#   auto        허브 성공 시 허브+더미(backend/dummy_data) 병합, 실패 시 더미만
#   hub         허브만 (실데이터 검증용, 실패 시 에러)
#   dummy(기본) backend/dummy_data만 — 외부 요청 없음
#   fixtures    contracts/fixtures 골든 데이터만 (계약 검증용)
A_LENS_SOURCE=dummy

# ── a-hub work (이슈·페이지·재사용) ──
# a-hub-work base URL. 팀 배포 예시: https://spacea.msalt.net
A_LENS_WORK_URL=

# 허브 Bearer 토큰 (POST /agents/register로 발급)
A_LENS_WORK_TOKEN=

# 허브 x-api-key 헤더 값 (2026-07-19 허브 인증 전환) — 값은 팀 안전 채널로 공유
A_LENS_WORK_API_KEY=

# 프레즌스 online 판정 창(초, 기본 3600) — 이 시간 안에 write 한 사람만 online 으로 표시
A_LENS_PRESENCE_WINDOW=3600

# 허브 폴링 캐시(초)
A_LENS_CACHE_TTL=30

# ── a-hub life (사람 이름·마스코트 이미지) ──
# work와 **별개 서버**다. 비우면 Life 연동 전체가 조용히 off(Hub-only 화면 그대로).
A_LENS_LIFE_URL=
A_LENS_LIFE_TOKEN=
A_LENS_LIFE_API_KEY=

# Life 닉네임 → work 계정 id 별칭 매핑. Life가 hub_user_id를 주기 전(구버전 서버) 수동 보정용.
# "닉네임=hub_user_id"를 쉼표로 잇는다. 한 사람의 허브 계정이 여러 개면 `|`로 잇는다
# (화면에서는 한 줄로 합쳐진다):  봇돌이=agent-a,야옹이=agent-b|agent-b-mate
A_LENS_LIFE_ALIAS=

# ── LLM API (분류→요약→서사 번역, OpenAI 호환) ──
# 기본은 비활성(빈 URL) — 미설정이면 번역·잡담이 즉시 규칙 폴백으로 동작한다.
# 켜려면 OpenAI 호환 엔드포인트를 넣는다(예: 로컬 LM Studio http://localhost:1234/v1).
# 설정 창(로비 ⚙ 설정)에서 바꾼 값이 .a-lens/settings.json에 저장돼 env보다 우선한다.
A_LENS_LLM_URL=
A_LENS_LLM_MODEL=qwen/qwen3/qwen3-30b-a3b-instruct-2507-q4_k_m.gguf
A_LENS_LLM_KEY=

# 요약 길이: brief(한 문장·담백) | normal(2~3문장) | detailed(3~5문장). 바꾸면 재번역된다.
A_LENS_SUMMARY_STYLE=brief

# 번역 캐시 DB(SQLite). 비우면 캐시 없이 매번 재번역. 기본은 backend/.a-lens/translation.db
A_LENS_DB=

# ── 개발용 (평소엔 설정하지 않음) ──
# 런타임 설정 파일 경로 오버라이드. 기본은 backend/.a-lens/settings.json.
# 저장된 설정을 무시하고 순수 env로 띄우고 싶을 때 빈 경로를 가리키면 된다.
#A_LENS_SETTINGS=

# 프론트 dev 서버가 /api를 프록시할 백엔드 포트(기본 8600). 이 파일이 아니라
# **frontend 셸**에서 지정해야 vite.config.ts가 읽는다.
#A_LENS_API_PORT=8600
