# a-lens backend 환경변수 — 복사해서 .env로 쓰거나 셸에서 export
# (허브 주소는 배포에 따라 바뀔 수 있으므로 코드에 고정하지 않는다)

# 원천: auto | hub | dummy | fixtures
#   auto(기본)  허브 성공 시 허브+더미(backend/dummy_data) 병합, 실패 시 더미만
#   hub         허브만 (실데이터 검증용, 실패 시 에러)
#   dummy       backend/dummy_data만
#   fixtures    contracts/fixtures 골든 데이터만 (계약 검증용)
A_LENS_SOURCE=auto

# a-hub-work base URL
A_LENS_WORK_URL=https://spacea.msalt.net

# 허브 Bearer 토큰 (POST /agents/register로 발급)
A_LENS_WORK_TOKEN=

# 허브 x-api-key 헤더 값 (2026-07-19 허브 인증 전환)
# @msalt 님이 디스코드로 공유한 x-api-key 참고
A_LENS_WORK_API_KEY=

# 프레즌스 online 판정 창(초, 기본 3600) — 이 시간 안에 write 한 사람만 online 으로 표시
A_LENS_PRESENCE_WINDOW=3600

# 허브 폴링 캐시(초)
A_LENS_CACHE_TTL=30
