{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Mentor",
  "version": "0.1.0",
  "identifier": "dev.agentmentor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "chat",
        "url": "chat.html",
        "title": "agent mentor",
        "width": 1000,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "설정 — agent mentor",
        "width": 520,
        "height": 720,
        "minWidth": 440,
        "minHeight": 420,
        "resizable": true,
        "visible": false
      },
      {
        "label": "mascot",
        "url": "mascot.html",
        "title": "mentor",
        "width": 280,
        "height": 280,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/128x128.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dev-team-404/a-mate-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QTA2RDM0MzEyRTg3REQKUldUZGh5NHhORzJnbU1RbDdVb3Nnb0VwY1p5VWtaRktybzVMaG1GL3RacWREU0lSMzlZcVpJMGcK"
    }
  }
}
