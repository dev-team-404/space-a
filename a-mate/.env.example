# Agent Mentor 환경변수 예시 — 이 파일을 .env로 복사하고 값을 채우세요.
# dev 빌드는 프로젝트 루트 .env를 자동 로드합니다 (src-tauri run()의 dotenvy, #[cfg(debug_assertions)]).
# 릴리스(설치본) 빌드는 .env를 읽지 않습니다 — 값은 트레이 우클릭 → 설정 창에서 넣으세요.
# 코드가 읽는 변수명은 아래와 정확히 같아야 합니다 (crates/core/src/diary/engine.rs::from_env).
#
# 해석 우선순위: **설정 창(store) → 아래 환경변수 → 코드 기본값** (src-tauri/src/lib.rs::resolve_engine).
# 설정 창에서 엔드포인트를 한 번 저장했다면 .env 값은 무시됩니다.
#
# 전부 미설정이어도 앱은 정상 부팅하고 수집·규칙·코칭 카드·UI는 그대로 동작합니다.
# LLM을 쓰는 기능만 조용히 쉽니다(에러 아님): 다이어리는 그날치를 **건너뛰고**(엔진이 생기면 밀린
# 날짜를 보충), 채팅 탭은 설정 안내를 표시합니다. 앱 경로에 mock 폴백은 없습니다
# (`cargo run` CLI만 mock 엔진으로 떨어집니다).

# ── LLM 엔진 — 다이어리·채팅·코칭 판정·번역 ──────────────────────────
# OpenAI 호환 엔드포인트 — 이 값이 있어야 실엔진 사용.
# 이 앱은 네이티브 Windows 프로세스이므로 localhost로 접속하세요.
# (host.docker.internal은 Docker 컨테이너 내부 전용 DNS라 네이티브에선 해석 안 됨.
#  프록시가 컨테이너면 포트를 호스트에 노출: -p 4444:4444)
AGENT_MENTOR_ENGINE_URL=http://localhost:4444/v1

# API 키 — 선택(기본: 빈 문자열). 실제 키는 여기 두지 말고 .env에만 넣으세요.
AGENT_MENTOR_ENGINE_KEY=

# 모델명 — 선택(기본: gpt-4o-mini).
AGENT_MENTOR_ENGINE_MODEL=gpt-4.1-mini

# 추가 헤더 — 선택. 사내 게이트웨이가 신원 헤더를 요구할 때만.
# 한 줄에 하나씩 `이름: 값`. 줄바꿈은 \n으로 적는다(.env는 여러 줄을 못 담는다).
#AGENT_MENTOR_ENGINE_HEADERS=x-user-id: abc\nx-dept-name: s/w개발팀\nx-service-id: service-a

# ── a-hub("Space A") 팀 연동 (선택) ───────────────────────────────────
# 설정하는 행위 = egress 동의. URL 미설정이면 공유·텔레메트리·회고가 **전부** 조용히 꺼진다.
# 나가는 것은 결정론적으로 증류한 값뿐 — 대화 원문·파일 경로·세션 ID는 어떤 채널로도 안 나간다.
# 현행 문서: docs/architecture/a-mate/02-features.md §8 · docs/architecture/a-mate/03-architecture.md §7
#SPACE_A_HUB_URL=https://spacea.msalt.net
#SPACE_A_API_KEY=            # 서버 게이트 키 (배포가 요구할 때)
#SPACE_A_TOKEN=              # 선택 — 없으면 최초 1회 자동 register 후 로컬 보존
#SPACE_A_SPACE_ID=sw-innov   # 발행할 공간 (기본 sw-innov)
#SPACE_A_USER=               # register용 user_id (기본 %USERNAME%)
#SPACE_A_SHARE=on            # off면 URL이 있어도 지식 공유만 끔
#SPACE_A_SHARE_MIN_TOKENS=1000

# 텔레메트리(하루 1회 숫자만) 발행 공간 — 기본 a-mate-telemetry.
#SPACE_A_TELEMETRY_SPACE_ID=a-mate-telemetry

# 세션 회고 — 오류를 겪고 회복한 세션의 로컬 생성 요약을 발행.
#SPACE_A_RETRO=off           # off면 회고 발행만 끔 (기본 on)
#SPACE_A_RETRO_DAILY_CAP=    # 하루 상한. 기본 무제한 (나깅 방지는 세션당 평생 1회 dedup이 담당)
#SPACE_A_RETRO_MIN_ERRORS=3  # 회고 대상 최소 오류 수
#SPACE_A_RETRO_MIN_EVENTS=20 # 회고 대상 최소 이벤트 수

# ── AI 스프라이트 — 캐릭터 이미지 생성 (선택) ─────────────────────────
# 최초 1회 사용자별 캐릭터를 생성해 app_data/sprite.png에 캐시. 실패/미설정 시 절차 생성 폴백.
# 이미지 전용 값이 있으면 그것을, 없으면 위 텍스트 엔진 값을 폴백으로 쓴다 — 텍스트는 사내
# LM Studio, 이미지는 OpenRouter처럼 **엔드포인트를 분리**할 수 있게 하기 위함.
#AGENT_MENTOR_IMAGE_URL=https://openrouter.ai/api/v1   # 없으면 AGENT_MENTOR_ENGINE_URL 사용
#AGENT_MENTOR_IMAGE_KEY=                               # 없으면 AGENT_MENTOR_ENGINE_KEY 사용
#AGENT_MENTOR_IMAGE_MODEL=google/gemini-2.5-flash-image # 기본값도 동일
#AGENT_MENTOR_SPRITE=off     # 스프라이트 생성 끄기

# 이미지 API 방식 — chat(기본) | images.
#  chat  : POST {URL}/chat/completions — OpenRouter·LiteLLM. 화풍 견본 이미지를 함께 보낸다.
#  images: POST {URL}/images/generations — OpenAI 규격(사내 게이트웨이 다수).
#          이 규격은 참조 이미지를 못 받으므로 화풍을 프롬프트 문장으로만 지시한다.
#AGENT_MENTOR_IMAGE_API=images

# 추가 헤더 — 텍스트 엔진과 **따로** 지정한다(이미지가 다른 게이트웨이일 수 있으므로).
#AGENT_MENTOR_IMAGE_HEADERS=x-user-id: abc\nx-dept-name: s/w개발팀\nx-service-id: service-a

# ── 개발·튜닝용 (평소엔 설정하지 않음) ────────────────────────────────
# 데이터 디렉터리 오버라이드 — 한 PC에서 두 인스턴스를 돌릴 때만.
# 미설정이면 Tauri app_data_dir. DB(agent-mentor.db)와 캐시가 이 아래로 간다.
#AGENT_MENTOR_DATA_DIR=

# 콘텐츠 큐레이션 피드를 네트워크 대신 로컬 파일에서 읽는다 (오프라인 테스트).
# `cargo run` CLI와 examples/curation_server 전용 — 앱은 읽지 않는다.
#AGENT_MENTOR_CHANGELOG_FILE=
