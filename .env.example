# Agent Mentor 엔진 설정 예시 — 이 파일을 .env로 복사하고 값을 채우세요.
# dev 빌드는 프로젝트 루트 .env를 자동 로드합니다 (src-tauri run()의 dotenvy, #[cfg(debug_assertions)]).
# 코드가 읽는 변수명은 아래와 정확히 같아야 합니다 (crates/core/src/diary/engine.rs::from_env).
# 미설정 시: 다이어리는 mock으로 폴백, 채팅 탭은 설정 안내를 표시(에러 아님).

# OpenAI 호환 엔드포인트 — 필수. 이 값이 있어야 실엔진 사용(없으면 mock).
# 이 앱은 네이티브 Windows 프로세스이므로 localhost로 접속하세요.
# (host.docker.internal은 Docker 컨테이너 내부 전용 DNS라 네이티브에선 해석 안 됨.
#  프록시가 컨테이너면 포트를 호스트에 노출: -p 4444:4444)
AGENT_MENTOR_ENGINE_URL=http://localhost:4444/v1

# API 키 — 선택(기본: 빈 문자열). 실제 키는 여기 두지 말고 .env에만 넣으세요.
AGENT_MENTOR_ENGINE_KEY=

# 모델명 — 선택(기본: gpt-4o-mini).
AGENT_MENTOR_ENGINE_MODEL=gpt-4.1-mini
