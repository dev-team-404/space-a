# A-Hub 환경변수 예시 — 이 파일을 a-hub/.env로 복사하고 값을 채우세요.
#
# work/와 life/는 **별개 서버 프로세스**이고 변수도 공유하지 않는다(`SPACE_A_*` vs `LIFE_SERVER_*`).
# 그런데도 파일이 하나인 이유: docker compose는 **compose 파일 옆의 .env 하나만** 읽는다.
# work/.env·life/.env를 만들어도 compose는 보지 않으므로, 통합 배포의 정본은 여기다
# (루트 docker-compose.yml이 두 서비스를 함께 띄우는 집계 파일인 것과 같은 이유).
# - docker compose: 이 디렉터리의 .env를 자동으로 읽어 `${...}` 보간에 쓴다.
# - 로컬 직접 실행(uvicorn): .env를 자동 로드하지 않는다. 셸에 직접 넣어야 한다.
#     PowerShell:  $env:SPACE_A_DB = "./space_a.db"
#     bash:        set -a && source .env && set +a
#
# 실행 절차: docs/architecture/a-hub/build-and-run.md

# ── docker compose가 보간하는 값 ──────────────────────────────────────
# 사내망에서 pip이 TLS 검사에 막힐 때 빌드 인자로 전달할 옵션. 사외망에선 비워 둔다.
PIP_TRUSTED=

# x-api-key 관문. 값이 있으면 /healthz·/readyz를 뺀 모든 요청에 x-api-key가 필요하다.
# 비우면 관문 비활성(= 누구나 호출 가능). 두 서버는 **각자 다른 변수·다른 키**를 쓴다.
# 로컬 uvicorn 실행에서도 같은 변수명을 셸에 넣으면 된다.
SPACE_A_API_KEY=
LIFE_SERVER_API_KEY=

# ── work (space-a-hub) — 로컬 직접 실행용 ─────────────────────────────
# 스토어 선택: SPACE_A_TABLE(DynamoDB) > SPACE_A_DB(SQLite) > 없으면 인메모리(재시작 시 소멸).
# compose는 컨테이너 안에서 /data/space_a.db로 이미 고정해 두므로 여기서 설정할 필요 없다.
#SPACE_A_DB=./space_a.db

# (x-api-key 관문 SPACE_A_API_KEY는 위 compose 섹션에 있다 — 로컬 실행도 같은 변수명)

# ── work 서버리스(Lambda 개발 배포) 전용 ──────────────────────────────
# DynamoDB 테이블명. 설정하면 SQLite·인메모리보다 우선한다.
#SPACE_A_TABLE=
#AWS_DEFAULT_REGION=us-east-1   # 미설정 시 AWS_REGION → us-east-1 순으로 폴백

# ── life (life-server) — 로컬 직접 실행용 ─────────────────────────────
# 설정하면 SQLite로 영속(등록·방·위치 유지). 비우면 인메모리.
# compose는 컨테이너 안에서 /data/life.db로 이미 고정해 두므로 여기서 설정할 필요 없다.
#LIFE_SERVER_DB=./life.db
