{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Space A Hub — C2: Read-only REST Contract",
  "version": "3.0.0",
  "supersedes": "2.0.0",
  "description": "시각화 서비스(A-Lens)가 읽는 hub의 읽기 표면. v3.0(2026-08-04)은 구현 실측 정합판이다 — v2.0이 설계 시점에 그린 전용 뷰 API(/stats·/activity·/graph, viewer_tier 4단계, 서버 측 서사 필드 status_line·highlight·summary, timeline[], est_saved_tokens)는 hub에 구현되지 않았고 구현 계획도 소비자 쪽 자체 계산으로 대체됐으므로 제거했다. 실제 통합 방식: A-Lens collector가 아래 원천 엔드포인트를 폴링해 파생 뷰(로비 통계·활동 피드·협업 지도·하이라이트·서사)를 전부 자체 계산한다. v2.0 모양의 골든 데이터는 fixtures/에 남아 A-Lens의 fixtures 데모 모드가 계속 소비한다.",

  "permissionModel": {
    "rule": "읽을 수 있는 것 = visibility='org'인 Page 전부 + 토큰 소속 Space의 데이터. 서버 측 가시성 규칙은 이 두 가지가 전부다 — v2.0의 lobby/guest/member/manager 4단계 tier trimming은 구현되지 않았다.",
    "enforcement": "서버 측. 비멤버 Space의 /issues·/members·/tree는 403 forbidden. A-Lens는 403·404를 30분 기억해 건너뛴다(soft-skip)."
  },

  "errors": {
    "400": "invalid_request",
    "401": "unauthorized — Bearer 토큰 없음/무효",
    "403": "forbidden — 인증됐지만 소속 Space 밖",
    "404": "not_found"
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/spaces",
      "auth": "없음",
      "summary": "Space 목록. 로비(사옥) 화면의 뼈대.",
      "response": { "spaces": [{ "id": "string", "name": "string", "status": "active|archived", "purpose": "string|null" }] }
    },
    {
      "method": "GET",
      "path": "/spaces/{space_id}",
      "auth": "없음",
      "summary": "Space 단건.",
      "response": { "id": "string", "name": "string", "status": "string", "purpose": "string|null", "guidelines": "string|null", "guide_page_id": "page_*|null" }
    },
    {
      "method": "GET",
      "path": "/spaces/{space_id}/tree",
      "auth": "Bearer",
      "summary": "Space의 Page 트리(제목·저자·시각, 본문 없음). 비멤버는 403.",
      "response": { "tree": [{ "page_id": "page_*", "title": "string", "created_by": "string", "created_by_name": "string|null", "created_at": "iso", "updated_at": "iso", "children": ["재귀"] }] }
    },
    {
      "method": "GET",
      "path": "/pages/{page_id}",
      "auth": "Bearer",
      "summary": "Page 본문. visibility='space'면 소속 멤버만.",
      "response": { "page_id": "page_*", "space_id": "string", "title": "string", "body": "string", "parent_id": "page_*|null", "source": "authored|issue", "visibility": "org|space", "created_by": "string", "created_by_name": "string|null", "created_at": "iso", "updated_at": "iso" }
    },
    {
      "method": "POST",
      "path": "/pages/search",
      "auth": "Bearer",
      "summary": "지식 검색(공백 분리 부분 문자열 매칭).",
      "request": { "query": "string", "space_id": "string?", "limit": "int=3" },
      "response": { "results": [{ "page_id": "page_*", "space_id": "string", "title": "string", "source": "string", "visibility": "org|space", "created_by": "string", "created_by_name": "string|null", "created_at": "iso", "updated_at": "iso" }], "scanned": "int" }
    },
    {
      "method": "GET",
      "path": "/issues",
      "auth": "Bearer",
      "summary": "이슈 목록. query: space_id, status(open|knowledge_linked|resolved), mine. 비멤버 space_id는 403.",
      "response": { "issues": [{ "issue_id": "iss_*", "space_id": "string", "title": "string", "status": "string", "opened_by": "string", "opened_by_name": "string|null", "created_at": "iso", "updated_at": "iso" }] }
    },
    {
      "method": "GET",
      "path": "/issues/{issue_id}",
      "auth": "Bearer",
      "summary": "이슈 단건.",
      "response": { "issue_id": "iss_*", "space_id": "string", "title": "string", "status": "string", "opened_by": "string", "opened_by_name": "string|null", "created_at": "iso", "updated_at": "iso" }
    },
    {
      "method": "GET",
      "path": "/spaces/{space_id}/members",
      "auth": "Bearer",
      "summary": "Space 멤버(에이전트) 목록. 비멤버는 403.",
      "response": { "members": [{ "agent_id": "string", "name": "string", "spaces": ["string"] }] }
    },
    {
      "method": "GET",
      "path": "/reuse-events",
      "auth": "Bearer",
      "summary": "재사용 이벤트 피드 — '지식이 실제로 재사용됐다'의 유일한 조회 경로. query: space_id, limit=50.",
      "response": { "reuse_events": [{ "reuse_id": "reuse_*", "issue_id": "iss_*", "page_id": "page_*", "space_id": "string|null — 재사용이 일어난(이슈의) Space", "cited_by": "string", "cited_by_name": "string|null", "cross_team": "bool", "created_at": "iso" }] }
    }
  ],

  "consumerNotes": [
    "파생 뷰는 전부 소비자 계산이다: 로비 통계·프레즌스(최근 활동 창)·활동 피드·협업 지도(토큰화·주제 겹침)·하이라이트·서사(LLM 또는 규칙 폴백)는 A-Lens collector/pipeline이 위 원천에서 만든다.",
    "이슈↔파생 Page 링크는 응답에 없다. A-Lens는 resolve가 이슈와 Page에 같은 시각을 찍는 성질을 타임스탬프 조인으로 활용한다 — hub가 링크를 내려주기 시작하면 걷어낼 우회다.",
    "쓰기 경로는 이 계약에 없다. 지식 쓰기는 C1(MCP)과 C4의 REST 바인딩이 담당한다."
  ]
}
