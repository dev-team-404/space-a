{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Space A Hub — C2: Read-only REST Contract",
  "version": "1.0.0",
  "description": "Read-only endpoints consumed by Pillar 3 (community visualization). Pillar 3 does NOT connect to the graph DB directly: doing so would turn the graph schema into a public API and freeze it. These three endpoints are the entire surface. The only write path into Space A is C1 (MCP).",

  "$defs": {
    "nodeType": {
      "type": "string",
      "enum": ["Agent", "Task", "Issue", "MCP_Tool", "Skill"]
    },
    "edgeType": {
      "type": "string",
      "enum": ["USED_BY", "RESOLVED", "DEPENDS_ON", "REUSED", "PROMOTED_TO"],
      "description": "REUSED is the money edge: agent B reused what agent A solved. That is knowledge crossing a team boundary — the core story of this project."
    },
    "eventType": {
      "type": "string",
      "enum": ["recorded", "reused", "condensed", "skill_proposed"]
    }
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/graph",
      "summary": "Nodes and edges for the knowledge network map. Private knowledge is filtered out server-side and never appears here.",
      "query": {
        "type": "object",
        "properties": {
          "team": { "type": "string", "description": "Filter to one team. Omit for org-wide." },
          "since": { "type": "string", "format": "date-time" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
        }
      },
      "response": {
        "type": "object",
        "required": ["nodes", "edges"],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "label"],
              "properties": {
                "id": { "type": "string" },
                "type": { "$ref": "#/$defs/nodeType" },
                "label": { "type": "string", "description": "Human-readable, ready to render. Do not build this on the frontend." },
                "team": { "type": "string" },
                "reuse_count": { "type": "integer" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "target", "type"],
              "properties": {
                "source": { "type": "string" },
                "target": { "type": "string" },
                "type": { "$ref": "#/$defs/edgeType" },
                "at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },

    {
      "method": "GET",
      "path": "/stats",
      "summary": "Aggregate dashboard numbers.",
      "query": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" }
        }
      },
      "response": {
        "type": "object",
        "required": ["period", "totals"],
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "format": "date" },
              "to": { "type": "string", "format": "date" }
            }
          },
          "totals": {
            "type": "object",
            "properties": {
              "issues": { "type": "integer" },
              "solutions": { "type": "integer" },
              "skills": { "type": "integer" },
              "reuses": { "type": "integer" }
            }
          },
          "top_reused_skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_id": { "type": "string" },
                "name": { "type": "string" },
                "reuse_count": { "type": "integer" }
              }
            }
          },
          "top_issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "issue_id": { "type": "string" },
                "title": { "type": "string" },
                "occurrences": { "type": "integer" }
              }
            }
          },
          "tokens_saved_est": {
            "type": "integer",
            "description": "ESTIMATE. Tokens avoided versus injecting the raw logs. The frontend must label this with '~' — never present it as measured."
          },
          "by_team": {
            "type": "array",
            "description": "contributed vs reused shows which teams are net givers and which are net takers of knowledge.",
            "items": {
              "type": "object",
              "properties": {
                "team": { "type": "string" },
                "contributed": { "type": "integer" },
                "reused": { "type": "integer" }
              }
            }
          }
        }
      }
    },

    {
      "method": "GET",
      "path": "/activity",
      "summary": "Chronological feed of knowledge flow — the 'spectating' view for humans.",
      "query": {
        "type": "object",
        "properties": {
          "since": { "type": "string", "format": "date-time" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "response": {
        "type": "object",
        "required": ["events"],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at", "type", "summary"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "type": { "$ref": "#/$defs/eventType" },
                "actor": { "type": "string" },
                "issue_id": { "type": "string" },
                "skill_id": { "type": "string" },
                "summary": {
                  "type": "string",
                  "description": "A ready-to-render Korean sentence, composed server-side. The frontend must NOT assemble this from parts — otherwise every new event type would require a frontend change."
                }
              }
            }
          }
        }
      }
    }
  ]
}
