{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Space A Hub — C1: MCP Tool Contract",
  "version": "2.1.0",
  "supersedes": "2.0.0",
  "description": "Space A MCP 서버가 에이전트(A-Mate와 모든 MCP 클라이언트)에 노출하는 도구 계약. v2.1(2026-08-04)은 구현 실측 정합판이다 — v2.0의 설계 시점 표면 중 구현되지 않은 부분(confidence·solution·tried_and_failed·related 필드, searched 퍼널, X-Space-A-Trace-Id/Depth 헤더, rate_limited 코드, agt_*/doc_*/skl_* id 체계)을 제거하고, 실제 서버(a-hub/work/ahub/api/mcp_server.py)가 주고받는 모양을 그대로 기록했다. 지식의 식별자는 doc_id가 아니라 page_id다(Page가 지식의 실체). 변경 정책: v2.1부터 다시 추가만 허용(additive only) — 소비자는 모르는 필드를 무시한다.",

  "transport": {
    "description": "신원은 도구 인자가 아니라 전송 계층에서 온다. MCP 앱은 Streamable HTTP로 REST 서버의 /mcp에 마운트되며, 서버가 요청별 Authorization 헤더를 읽어 Bearer 토큰으로 에이전트와 소속 space를 판별한다.",
    "http": {
      "Authorization": {
        "required": true,
        "format": "Bearer <token>",
        "description": "POST /agents/register(C4)가 발급한 토큰. 서버가 { agent_id, spaces[] }로 해석한다. spaces는 토큰에서만 유도되며 요청 인자로 받지 않는다 — 클라이언트가 소속을 주장하게 하면 권한 모델이 무너진다."
      }
    }
  },

  "permissionModel": {
    "rule": "에이전트가 읽을 수 있는 것 = visibility='org'인 지식 전부 + 자기가 속한 Space의 데이터. 그 외엔 없다.",
    "enforcement": "서버 측. 토큰의 spaces[]에서 유도하며 요청 파라미터를 신뢰하지 않는다. search_knowledge의 space_id 인자는 범위를 좁힐 뿐, 소속하지 않은 Space를 열지 못한다."
  },

  "$defs": {
    "visibility": {
      "type": "string",
      "enum": ["org", "space"],
      "default": "org",
      "description": "지식 공개 범위. org = 전사 열람(기본 — 지식은 순환하라고 있는 것), space = 소속 Space 멤버만."
    },
    "spaceId": { "type": "string", "examples": ["sw-innov"] },
    "issueId": { "type": "string", "pattern": "^iss_", "examples": ["iss_1"] },
    "pageId": { "type": "string", "pattern": "^page_", "examples": ["page_7"] },
    "reuseId": { "type": "string", "pattern": "^reuse_", "examples": ["reuse_1"] },
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": ["invalid_request", "unauthorized", "forbidden", "not_found"],
              "description": "unauthorized = 토큰 없음/무효. forbidden = 인증됐지만 소속 Space 밖."
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  },

  "tools": [
    {
      "name": "get_guide",
      "description": "이 Space의 작성 가이드를 읽는다. 처음 쓰는 Space라면 쓰기 전에 먼저 호출한다. 공개 space 정보라 인증을 요구하지 않는다.",
      "inputSchema": {
        "type": "object",
        "required": ["space_id"],
        "properties": { "space_id": { "$ref": "#/$defs/spaceId" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "oneOf": [
          { "type": "object", "properties": { "guide": { "const": null } }, "description": "가이드가 없는 Space" },
          {
            "type": "object",
            "required": ["page_id", "title", "body"],
            "properties": {
              "page_id": { "$ref": "#/$defs/pageId" },
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        ]
      }
    },

    {
      "name": "search_knowledge",
      "description": "유사한 과거 해결책을 찾는다. 스스로 추론하기 전에 먼저 호출한다. 권한 범위(org 공개 + 내가 속한 space) 안에서만 검색된다. 현재 검색은 공백 분리 부분 문자열 매칭이다(의미 검색 아님 — 알려진 제약).",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "space_id": { "$ref": "#/$defs/spaceId", "description": "선택: 검색 범위를 소속 Space 하나로 좁힌다." },
          "limit": { "type": "integer", "default": 3 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["results", "scanned"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["page_id", "space_id", "title"],
              "properties": {
                "page_id": { "$ref": "#/$defs/pageId" },
                "space_id": { "$ref": "#/$defs/spaceId", "description": "이 지식을 만든 Space. 내 소속과 다를 수 있다 — 그것이 지식이 팀 경계를 넘는 순간이다." },
                "title": { "type": "string" },
                "source": { "type": "string", "enum": ["authored", "issue"], "description": "직접 저작 vs 이슈 해결에서 파생" },
                "created_by": { "type": "string" },
                "created_by_name": { "type": ["string", "null"] },
                "created_at": { "type": "string" },
                "updated_at": { "type": "string" }
              }
            }
          },
          "scanned": { "type": "integer", "description": "검색이 살펴본 후보 수." }
        }
      }
    },

    {
      "name": "open_issue",
      "description": "문제가 생긴 시점에 이슈를 연다 (해결 후가 아니라). 진행 중 이슈가 기록돼야 관전 화면이 살아있는 타임라인을 그릴 수 있다.",
      "inputSchema": {
        "type": "object",
        "required": ["title", "space_id"],
        "properties": {
          "title": { "type": "string" },
          "space_id": { "$ref": "#/$defs/spaceId", "description": "소속한 Space여야 한다." }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["issue_id", "status"],
        "properties": {
          "issue_id": { "$ref": "#/$defs/issueId" },
          "status": { "type": "string", "enum": ["open"] }
        }
      }
    },

    {
      "name": "cite_knowledge",
      "description": "기존 문서를 이 이슈에 재사용으로 기록한다. 이 순간 ReuseEvent가 생긴다 — 한 팀의 지식이 다른 팀의 문제를 푸는, 이 시스템에서 가장 중요한 이벤트다. 검색 결과를 쓰기로 결정한 즉시 호출한다.",
      "inputSchema": {
        "type": "object",
        "required": ["issue_id", "page_id"],
        "properties": {
          "issue_id": { "$ref": "#/$defs/issueId" },
          "page_id": { "$ref": "#/$defs/pageId", "description": "search_knowledge 결과에서 재사용하기로 한 문서." },
          "note": { "type": "string", "description": "왜 적용되는지 한 줄." }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["reuse_id", "page_id", "cross_team", "issue_status"],
        "properties": {
          "reuse_id": { "$ref": "#/$defs/reuseId" },
          "page_id": { "$ref": "#/$defs/pageId" },
          "cross_team": { "type": "boolean", "description": "지식의 원 Space와 이슈의 Space가 다르면 true — 팀 경계를 넘은 재사용." },
          "issue_status": { "type": "string", "enum": ["knowledge_linked"] }
        }
      }
    },

    {
      "name": "resolve_issue",
      "description": "해결을 기록하고 이슈를 닫는다. publish_knowledge면 해결이 Page로 발행된다. 남에게 도움될 공유 가치가 있으면 visibility='org'로, 개인적 해결 기록이면 'space'로 낮춘다. MCP는 이슈가 열린 그 space에 발행한다 — 자유 Page 저작은 REST가 담당한다.",
      "inputSchema": {
        "type": "object",
        "required": ["issue_id", "summary"],
        "properties": {
          "issue_id": { "$ref": "#/$defs/issueId" },
          "summary": { "type": "string", "description": "실제로 통한 해결 한 줄." },
          "steps": { "type": "array", "items": { "type": "string" } },
          "publish_knowledge": { "type": "boolean", "default": true },
          "visibility": { "$ref": "#/$defs/visibility" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["issue_id", "status"],
        "properties": {
          "issue_id": { "$ref": "#/$defs/issueId" },
          "status": { "type": "string", "enum": ["resolved"] },
          "page_id": { "$ref": "#/$defs/pageId", "description": "publish_knowledge=true였을 때만 존재." }
        }
      }
    },

    {
      "name": "get_skill_candidates",
      "description": "반복된 해결 패턴(= Skill 승격 후보)을 조회한다. 같은 해결이 3번 기록됐다는 것은 사람이 손으로 그만 해도 된다는 신호다. 현재 패턴 판정은 issue-derived Page의 동일 제목 집계다(알려진 제약).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "space_id": { "$ref": "#/$defs/spaceId" },
          "min_occurrences": { "type": "integer", "default": 3 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["candidates"],
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pattern", "occurrences", "page_ids"],
              "properties": {
                "pattern": { "type": "string" },
                "occurrences": { "type": "integer" },
                "page_ids": { "type": "array", "items": { "$ref": "#/$defs/pageId" } }
              }
            }
          }
        }
      }
    }
  ]
}
