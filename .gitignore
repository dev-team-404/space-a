# ─────────────────────────────────────────────
# Environment / secrets
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# a-mate updater 서명 개인키·암호 — 팀 안전 채널로만 공유, 커밋 금지
a-mate/dev-key/
# CA 인증서는 커밋 금지가 기본 — a-lens/.proxy-certs/의 사내망 빌드용 프록시 CA만 의도적 예외
*.crt
!a-lens/.proxy-certs/*.crt
# a-lens 런타임 설정(설정 창 저장값) — 토큰·API 키 포함 + 번역 캐시 DB
.a-lens/

# ─────────────────────────────────────────────
# Node / JavaScript / TypeScript
# ─────────────────────────────────────────────
node_modules/
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg

# ─────────────────────────────────────────────
# Serverless / AWS SAM build artifacts
# ─────────────────────────────────────────────
.aws-sam/
samconfig.toml

# ─────────────────────────────────────────────
# Databases / logs / temp
# ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.log
logs/
tmp/
temp/

